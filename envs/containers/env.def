# ==============================================================================
# nlp-envs の Python の環境 (nlp / llm / train)
# ==============================================================================
# 土台 (base) の SIF の上に、uv.lock のとおりの .venv を /opt/nlp-envs/.venv に作る。
# どの環境かは build.sh が --build-arg で渡す (ENV_NAME と、uv sync に足す EXTRAS)。
# --locked なので、uv.lock と違う版は入らない (lock を変えたら版を上げて作り直す)。
# ==============================================================================
Bootstrap: localimage
From: {{ BASE_SIF }}

%files
    pyproject.toml /opt/nlp-envs/pyproject.toml
    uv.lock /opt/nlp-envs/uv.lock
    README.md /opt/nlp-envs/README.md
    tests/smoke.py /opt/nlp-envs/smoke.py

%labels
    org.nlp-envs.env {{ ENV_NAME }}
    org.nlp-envs.version {{ VERSION }}
    org.nlp-envs.git-commit {{ GIT_COMMIT }}

%environment
    export NLP_ENV={{ ENV_NAME }}
    export NLP_ENV_VERSION={{ VERSION }}
    export VIRTUAL_ENV=/opt/nlp-envs/.venv
    export PATH=/opt/nlp-envs/.venv/bin:$PATH

%post
    set -eu
    cd /opt/nlp-envs
    export UV_PYTHON_INSTALL_DIR=/opt/uv/python
    export UV_PYTHON_PREFERENCE=only-managed
    export UV_PROJECT_ENVIRONMENT=/opt/nlp-envs/.venv
    # キャッシュは build.sh が --bind した機械の上の場所 (作り直しを速くする)。SIF には入れない
    export UV_CACHE_DIR={{ UV_CACHE_DIR }}
    export UV_LINK_MODE=copy
    # --locked: uv.lock が pyproject.toml と合っていなければ止まる (lock の直し忘れを防ぐ)
    uv sync --locked --compile-bytecode {{ EXTRAS }}
    # bind しなかったとき (/tmp の中) は、キャッシュを SIF に残さない
    case "$UV_CACHE_DIR" in /tmp/*) rm -rf "$UV_CACHE_DIR" ;; esac
    chmod -R a+rX /opt/nlp-envs

%test
    # 作るときの確認では、利用者のホームは見えない。キャッシュを書くライブラリ用に一時フォルダを使う
    tmp_home="$(mktemp -d)"
    trap 'rm -rf "$tmp_home"' EXIT
    export HOME="$tmp_home" XDG_CACHE_HOME="$tmp_home/.cache" HF_HOME="$tmp_home/hf" MPLCONFIGDIR="$tmp_home/mpl"
    /opt/nlp-envs/.venv/bin/python /opt/nlp-envs/smoke.py --env {{ ENV_NAME }} --no-gpu
